---
eleventyExcludeFromCollections: true
layout: layouts/page.njk
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
    - link
    - entry
    - note
    - tagList
eleventyComputed:
  title: Tagged “{{ tag }}”
  pageSpecificRobotsDirective: noindex
permalink: /tags/{{ tag }}/
---
<h1>Tagged “{{ tag }}”</h1>

<div class="l-stack l-stack--large">
  {% set postslist = collections[ tag ] | reverse %}
  {% include "postslist.njk" %}

  <p>See <a href="{{ '/tags/' | url }}">all tags</a>.</p>
</div>
