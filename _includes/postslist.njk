<div class="l-flow">
  {% if page.url == "/" %}<h2>Latest posts</h2>{% endif %}

<div class="h-feed">
  {% for post in postslist %}
  <article class="l-flow h-entry prose">

    <header class="l-flow l-flow--3xs">
      {# Show the post title for all post types except notes (unless it’s a note with a title) #}
      {% if (post.data.noteWithTitle or (post.data.postType !== 'note')) -%}
        <h3 class="feed-entry-title"><a rel="bookmark" class="p-name u-url" href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
      {% else -%}
        {# <p><a href="{{ post.url | url }}">{{ post.date | readableTime }}</a> <span>·</span> {{ post.data.location }}</span></p> #}
      {% endif -%}
      <div class="post__meta">
        <span class="u-visually-hidden">A {{ post.data.postType }} posted on</span>
        <time class="dt-published" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
        in
        <a rel="tag" href="/tags/{{ post.data.topLevelCategory | url }}" class="tag">{{ post.data.topLevelCategory }}</a>
      </div>
    </header>
    <div class="l-flow e-content">
      {%- if (post.data.postType === 'entry') -%}
        {{ post.content | excerpt | safe }}
      {%- else -%}
        {{ post.content | safe }}
      {%- endif -%}
      {#- We want: #}
        {#- To add a first (Nunjucks) filter (pretty sure a filter is appropriate) that: #}
          {#- if this is *not* the first post in the list: #}
          {#- we pass the post content into it: #}
          {#- and it replaces any instances of loading=eager with loading=lazy and decoding=auto with decoding=async: #}
        {#- And a second (Nunjucks) filter that: #}
          {#- if the post is an entry, reduces the content to an excerpt #}
          {#- and we add a continue reading link at the bottom #}
    </div>
    {%- if (post.data.postType === 'entry') -%}
    <footer>
      <a rel="bookmark" class="p-name u-url" href="{{ post.url | url }}">
        Continue reading <span class="u-visually-hidden">“{{ post.data.title }}”</span>
      </a>
    </footer>
    {%- endif -%}


    {# <footer class="stack">
      <div class="cluster">
        <ul class="tags">
        {% for tag in post.data.tags %}
          {%- if (tag != "posts") and (tag != "link") and (tag != "note") and (tag != "entry") -%}
          {% set tagUrl %}/tags/{{ tag }}/{% endset %}
          <li><a rel="tag" href="{{ tagUrl | url }}" class="tag">{{ tag }}</a></li>
          {%- endif -%}
        {% endfor %}
        </ul>
      </div>
    </footer> #}
  </article>
{% endfor %}
</div>

</div>
