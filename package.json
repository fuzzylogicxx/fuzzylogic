{
  "name": "fuzzy-logic",
  "version": "5.0.0",
  "description": "The personal website of Laurence Hughes, using the Eleventy static site generator.",
  "scripts": {
    "watch:eleventy": "eleventy --serve",
    "build:eleventy": "eleventy",
    "build:searchindex": "npx pagefind --site _site",
    "start": "npx @11ty/eleventy --serve --quiet",
    "build": "npm-run-all build:*"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/11ty/eleventy-base-blog.git"
  },
  "author": {
