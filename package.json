{
  "name": "fuzzy-logic",
  "version": "5.0.0",
  "description": "The personal website of Laurence Hughes, using the Eleventy static site generator.",
  "type": "module",
  "scripts": {
    "prebuild": "rm -rf _site/",
    "build": "npx @11ty/eleventy && npx pagefind --site _site",
    "start": "npx @11ty/eleventy --serve --quiet --incremental --ignore-initial",
    "debugstart": "DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy",
    "benchmark": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/11ty/eleventy-base-blog.git"
  },
  "author": {
    "name": "Zach Leatherman",
    "email": "zachleatherman@gmail.com",
    "url": "https://zachleat.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/11ty/eleventy-base-blog/issues"
  },
  "homepage": "https://github.com/11ty/eleventy-base-blog#readme",
  "devDependencies": {
    "pagefind": "^1.1.1"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.1",
    "@11ty/eleventy-img": "^6.0.1",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^2.0.3",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@zachleat/heading-anchors": "^1.0.2",
    "@zachleat/pagefind-search": "^1.0.3",
    "cssnano": "^7.0.7",
    "dotenv": "^8.2.0",
    "luxon": "^3.5.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-implicit-figures": "^0.12.0",
    "postcss": "^8.5.6",
    "zod": "^3.24.1",
    "zod-validation-error": "^3.4.0"
  }
}
