+  /* PROTOTYPE (throwaway): image sizing experiments. Apply in markdown with e.g. ![alt](src){.img-4x3}
+     - .img-cover: square sleeve, uncropped, capped at the text measure
+     - .img-4x3 / .img-16x9: crop to ratio. --focus nudges the crop vertically (default centre) */
+  @layer utilities {
+    /* Shape rules (data-shape is added at build time; see eleventy.config.js "imgShape").
+       - square: treated as a cover, uncropped, capped at the text measure
+       - landscape: cropped (never squashed) if taller than --landscape-max-ratio, i.e. 3:2 by default
+       Needs figure to be a size container so the cap is relative to the image’s own width. */
+    figure {
+      container-type: inline-size;
+      max-inline-size: var(--measure); /* one shared width: figures (and captions) match the text column */
+    }
+    img[data-shape="square"],
+    img.img-cover {
+      /* keep the 100% cap too: this overrides the base img max-width, which is what stops images overflowing narrow screens */
+      max-inline-size: min(var(--measure), 100%);
+    }
+    img[data-shape="landscape"] {
+      --landscape-max-ratio: 1.5;
+      width: 100%;
+      max-block-size: calc(100cqw / var(--landscape-max-ratio));
+      object-fit: cover;
+    }
+    img.img-4x3,
+    img.img-16x9 {
+      width: 100%;
+      height: auto;
+      max-inline-size: none;
+      object-fit: cover;
+      object-position: 50% var(--focus, 50%);
+    }
+    img.img-4x3 { aspect-ratio: 4 / 3; }
+    img.img-16x9 { aspect-ratio: 16 / 9; }
+  }
+
 
